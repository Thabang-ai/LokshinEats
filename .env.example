# LokshinEats web app — environment template.
# Copy to .env.local for development. NEXT_PUBLIC_ values are inlined into the
# browser bundle at build time, so they must be set when you run `next build`,
# not at runtime.

# ---- API ----
# Base URL of the LokshinEats REST API (see server/). Checkout, payments and
# order placement all go through it.
#
# Local development:  http://localhost:4000
# Production:         the deployed API's URL. Until the API is deployed,
#                     checkout will not work in a production build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Local emulators ----
# Point Firebase Auth and Firestore at the local emulators instead of the live
# project, so the whole stack can be exercised without touching real data.
# Leave unset (or "false") for anything other than local development.
#
# Start them with:  cd server && npm run emulator
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
