// Firestore Security Rules for LokshinEats
// These rules control who can read/write data in our database.
//
// IMPORTANT: this file is the source of truth in the repo, but Firestore only
// enforces what's deployed. Push changes with:
//   firebase deploy --only firestore:rules
// or paste into the Firebase console.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper to read another user's role.
    // (Inline get() works fine; this is just a readability convenience.)
    // -----------------------------------------------------------------------
    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isStoreOwner(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Platform operator. The `admin` role is set manually on a trusted user's
    // doc (Firebase console) — there is no admin self-signup. Admins get
    // full read oversight across the platform, plus the ability to reset or
    // remove orders for cleanup — but even admin writes are limited to
    // operational fields (status, driver assignment, cash/OTP flags); the
    // frozen financial fields (total, payouts, commission) can never be
    // touched by anyone after checkout.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fields an admin may reset on an order — deliberately excludes every
    // money field (subtotal, deliveryFee, total, vendorPayout, driverPayout,
    // platformEarnings, platformCommission, commissionRate,
    // driverDeliveryShare) and identity fields (customerId, storeId, items).
    function isAdminOrderReset() {
      return isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'driverId',
          'deliveryOTPVerified',
          'cashGivenToVendor', 'cashGivenAmount',
          'vendorCashConfirmed', 'vendorCashConfirmedAt',
          'vendorCashDisputed', 'vendorCashDisputedAt'
        ]);
    }

    // Users collection - users read/write their own data; admins may read any
    // user (for the operator console). Writes remain owner-only.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Stores collection
    // Reads: public (customers browse openly).
    // Create/delete: only by the future owner / current owner.
    // Update: the owner can update anything; ANY authenticated user can
    // update ONLY rating + reviewCount (the aggregate fields the review
    // transaction touches). Permissive but bounded — production would
    // enforce via Cloud Function instead.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.ownerId ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'reviewCount']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 0 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.reviewCount is int &&
          request.resource.data.reviewCount >= 0
        )
      );
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
    }

    // Products collection - anyone can read, only store owners can write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid;
    }

    // Orders collection
    // Reads: customer, assigned driver, store owner, and any driver looking at
    // available (unclaimed) orders.
    // Writes: customer create their own; updates by customer, assigned driver,
    // store owner, OR any driver claiming an available order.
    //
    // Drivers can see + claim orders as soon as the vendor accepts them
    // (status 'confirmed'), not just once food is 'ready' — this lets a
    // driver head toward the vendor while the food is still being prepared
    // instead of only finding out once it's already sitting done. Claiming
    // early only sets driverId (status is untouched until the vendor marks
    // it ready); claiming a 'ready' order still sets driverId + flips
    // straight to 'picked_up' in one step, same as before.
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.driverId ||
        isStoreOwner(resource.data.storeId) ||
        // any driver browsing available deliveries (confirmed, preparing, or ready)
        (resource.data.status in ['confirmed', 'preparing', 'ready'] &&
         resource.data.driverId == null &&
         userRole(request.auth.uid) == 'driver')
      );

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.customerId;

      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        // the assigned driver — covers early claim, release-back-to-null,
        // and confirming pickup (ready -> picked_up), all the same broad
        // trust already granted once driverId is theirs
        request.auth.uid == resource.data.driverId ||
        isStoreOwner(resource.data.storeId) ||
        // driver claiming an available order: must be a driver, must be
        // claiming for themselves, order must still be unclaimed
        (resource.data.status in ['confirmed', 'preparing', 'ready'] &&
         resource.data.driverId == null &&
         request.resource.data.driverId == request.auth.uid &&
         userRole(request.auth.uid) == 'driver') ||
        // admin resetting operational state — never money/identity fields
        isAdminOrderReset()
      );

      // Admin-only: remove an order from the operator console (e.g. stale
      // test data or an order resolved outside the app).
      allow delete: if isAdmin();
    }

    // Reviews collection - anyone can read, only customers who ordered can write
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.customerId;
    }

    // Drivers collection
    // Reads: public (customers see who's bringing their food).
    // The driver themselves owns their profile. ANY auth user can update
    // ONLY rating + ratingCount (the aggregate fields touched by the
    // driver-rating transaction). Same pattern as stores.
    match /drivers/{driverId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == driverId;
      allow update: if request.auth != null && (
        request.auth.uid == driverId ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'ratingCount']) &&
          request.resource.data.rating is number &&
          request.resource.data.rating >= 0 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.ratingCount is int &&
          request.resource.data.ratingCount >= 0
        )
      );
      allow delete: if request.auth != null && request.auth.uid == driverId;
    }

    // Driver reviews - public read, only customer can create their own
    match /driverReviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.customerId;
    }
  }
}
