// Firestore Security Rules for LokshinEats
// These rules control who can read/write data in our database.
//
// IMPORTANT: this file is the source of truth in the repo, but Firestore only
// enforces what's deployed. Push changes with:
//   firebase deploy --only firestore:rules
// or paste into the Firebase console.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper to read another user's role.
    // (Inline get() works fine; this is just a readability convenience.)
    // -----------------------------------------------------------------------
    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isStoreOwner(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Platform operator. The `admin` role is set manually on a trusted user's
    // doc (Firebase console, which bypasses these rules) — there is no admin
    // self-signup, and the users rules below refuse to write the value.
    //
    // Admins get full read oversight across the platform, plus the ability to
    // reset or remove orders for cleanup. Admin *writes* to an order are
    // limited to operational fields by isAdminOrderReset().
    //
    // The money fields really are frozen now, on every branch: orders can only
    // be created by the API, and the only client update permitted is the
    // customer's four review flags. Drivers and vendors cannot write to an
    // order at all — their pages call the API, which owns the lifecycle.
    //
    // Still open: a driver can READ an order they are assigned or that is
    // unclaimed, and the delivery code is stored on that document, so they can
    // still see it. Rules cannot hide a field. Closing that means moving the
    // code out of the order document — see "Known rules gaps" in
    // server/README.md.
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fields an admin may reset on an order — deliberately excludes every
    // money field (subtotal, deliveryFee, total, vendorPayout, driverPayout,
    // platformEarnings, platformCommission, commissionRate,
    // driverDeliveryShare) and identity fields (customerId, storeId, items).
    function isAdminOrderReset() {
      return isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'driverId',
          'deliveryOTPVerified',
          'cashGivenToVendor', 'cashGivenAmount',
          'vendorCashConfirmed', 'vendorCashConfirmedAt',
          'vendorCashDisputed', 'vendorCashDisputedAt'
        ]);
    }

    // The role a write would leave on a user document, and the one already
    // there. Defaulted so a document without a role field does not error.
    function incomingRole() {
      return request.resource.data.get('role', '');
    }
    function existingRole() {
      return resource.data.get('role', '');
    }

    // Whether a write leaves the role exactly as it found it.
    function roleUnchanged() {
      return incomingRole() == existingRole();
    }

    // Users collection - people read and write their own document; admins may
    // read any (for the operator console).
    //
    // Nobody writes a role here, their own included. The role field is the
    // most dangerous value in the database: isAdmin() reads it straight back
    // out, and the API believes it when a token carries no role claim. The
    // sign-up page used to let somebody pick `vendor` or `driver` and write
    // it from the browser, which is a role nobody granted them.
    //
    // Roles are earned through the API, which writes them with the Admin SDK
    // and is not subject to these rules: customer or driver applicant at
    // sign-up (POST /api/v1/users/me), vendor by registering a kitchen,
    // driver when an admin approves the application, admin out of band.
    //
    // A write that leaves the role exactly as it found it is fine - that is
    // somebody editing their name or their bank details, and an admin must
    // be able to do it on a document that still says 'admin'.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null && request.auth.uid == userId &&
        !('role' in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == userId &&
        roleUnchanged();

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // A kitchen is read by anyone (customers browse without signing in) and
    // written by nobody but the API.
    //
    // Every rule the platform has about a kitchen lives in the API's
    // serialiser and service: the R12 delivery fee, the opening hours, the
    // delivery areas, and whether an admin has approved the kitchen at all.
    // A browser that could write this document could skip all of them - and
    // did. `create` with no `verification` field produced a kitchen the API
    // reads as approved, so registering through the website bypassed the
    // review queue entirely; `update` let a kitchen LokshinEats had turned
    // down open itself for business.
    //
    // The website and all three apps now go through POST /api/v1/stores and
    // PATCH /api/v1/stores/mine, which own those rules. Note that the API
    // uses the Admin SDK and is not subject to these rules at all, so taking
    // writes away here costs it nothing.
    //
    // Reads stay open deliberately: the apps and the site read kitchens
    // through the API, but nothing here is secret - a kitchen's page is
    // public - and closing reads would break any older client still pointed
    // at Firestore without protecting anything.
    match /stores/{storeId} {
      allow read: if true;
      allow write: if false;
    }

    // Products collection - anyone can read, only store owners can write
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == request.auth.uid;
    }

    // Orders collection
    //
    // Reads: customer, assigned driver, store owner, and any driver browsing
    // unclaimed deliveries. Reads stay on Firestore so the vendor and driver
    // feeds update live; it is the writes that moved.
    //
    // Writes: none from a client, except the customer's review flags and the
    // admin console's operational reset. Everything else — placing an order,
    // claiming and releasing a delivery, advancing the status, confirming
    // delivery with the code, settling cash — goes through the API, which
    // enforces the lifecycle and owns every money field.
    //
    // Drivers can still see and claim orders as soon as the vendor accepts
    // them, not just once the food is 'ready', so a driver can head to the
    // store while it is still being made. That rule now lives in the API's
    // CLAIMABLE_STATUSES rather than here.
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.driverId ||
        isStoreOwner(resource.data.storeId) ||
        // any driver browsing available deliveries (confirmed, preparing, or ready)
        (resource.data.status in ['confirmed', 'preparing', 'ready'] &&
         resource.data.driverId == null &&
         userRole(request.auth.uid) == 'driver')
      );

      // Orders are created ONLY by the API, through the Admin SDK, which
      // bypasses these rules. Checkout moved to POST /api/v1/orders, and no
      // page in the web app calls addDoc on this collection any more.
      //
      // This is what actually closes the hole: previously the rule checked
      // only that customerId matched the caller, so a browser could mint an
      // order with any total, any payout figures, and paymentStatus 'paid'.
      // No field restriction would have made that safe — the prices have to
      // come from the product records, which a rule cannot read affordably.
      // Denying creation outright is the fix.
      //
      // Updates are still permitted below, because the vendor, driver and
      // customer order pages have not moved to the API yet. Those branches
      // carry no field restriction, so the money fields on an existing order
      // stay writable until they do. See server/README.md, "Known rules gaps".
      allow create: if false;

      // Updates are now almost entirely the API's job. The vendor and driver
      // order pages moved to it, so the broad "assigned driver may write
      // anything" and "store owner may write anything" branches are gone —
      // those were what let a driver set deliveryOTPVerified themselves, and
      // what left every money field writable after checkout.
      //
      // Two narrow exceptions remain:
      allow update: if request.auth != null && (
        // The customer marking their own order as reviewed. This is the only
        // order write the web app still makes directly, and it is restricted
        // to the four review flags — not the status, not the payment, and
        // none of the money fields.
        (
          request.auth.uid == resource.data.customerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reviewed', 'ratingGiven', 'driverRated', 'driverRatingGiven'
          ])
        ) ||
        // Admin resetting operational state from the console — never money
        // or identity fields; see isAdminOrderReset above.
        isAdminOrderReset()
      );

      // Admin-only: remove an order from the operator console (e.g. stale
      // test data or an order resolved outside the app).
      allow delete: if isAdmin();
    }

    // Reviews: public to read, and written by the API alone.
    //
    // "Only customers who ordered can write" is what the old rule was for,
    // but it could not check that: all it compared was the customerId on the
    // document the browser was writing, which the browser also chose. The API
    // checks the order - yours, and delivered - and refuses a second review
    // of the same meal.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    // Drivers collection
    // Reads: public (customers see who's bringing their food).
    // The driver themselves owns their profile. ANY auth user can update
    // ONLY rating + ratingCount (the aggregate fields touched by the
    // driver-rating transaction). Same pattern as stores.
    // Driver verification records belong to the API alone.
    //
    // They hold licence and identity numbers now, and this collection used to
    // be world-readable with drivers writing their own - which would have let
    // anyone read every driver's ID number, and every driver mark themselves
    // approved. Nothing client-side reads it; the apps ask the API, which
    // decides what each caller may see.
    match /drivers/{driverId} {
      allow read, write: if false;
    }

    // Driver reviews, as the website used to write them. Nothing writes here
    // any more: a driver's rating is a review in `reviews` with
    // target 'driver', and lives as an average on the driver's own record.
    // Left readable so the old documents are not lost.
    match /driverReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
