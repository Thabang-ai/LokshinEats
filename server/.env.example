# LokshinEats API — environment template.
# Copy to .env and fill in. Never commit .env.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call this API.
# The Flutter mobile apps are not browsers and are unaffected by CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Firebase ----
# Project that owns Auth + Firestore. Matches firebase/config.ts on the web app.
FIREBASE_PROJECT_ID=kasieats-34391

# Credentials. Pick ONE of these two:
#  1) On Google infrastructure (Cloud Run / GCE / Cloud Functions) leave both
#     blank — Application Default Credentials are picked up automatically.
#  2) Anywhere else, point at a service-account JSON file, or paste the JSON.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Platform economics ----
# Mirrors services/economics.ts. Rates are frozen onto each order at
# creation, so changing these never rewrites historical orders.
COMMISSION_RATE=0.08
DRIVER_DELIVERY_SHARE=0.85

# ---- Payments ----
# Which provider handles charges. "sandbox" implements the full payment path
# without moving real money, so the rest of the system can be built and tested
# before a merchant account is approved. Adding a live provider means writing
# one more adapter, not changing anything above it.
# "none" runs cash only: card and EFT orders are refused and the apps stop
# offering them. Production runs "none" until a live provider is connected.
PAYMENT_PROVIDER=sandbox

# The sandbox provider refuses to start when NODE_ENV=production. Set this
# only for a staging environment that runs with NODE_ENV=production but must
# not take real money.
ALLOW_SANDBOX_PAYMENTS=false

# Where a redirect-style provider should return the customer afterwards.
PAYMENT_RETURN_URL=

# ---- Notifications ----
# "off" keeps the in-app inbox and pushes nothing (the emulators have no
# messaging service). "fcm" also pushes through Firebase Cloud Messaging.
PUSH_PROVIDER=off

# ---- Security ----
# Requests per window per IP, applied to the whole API surface.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Tighter bucket for auth + payment endpoints.
RATE_LIMIT_SENSITIVE_MAX=20
