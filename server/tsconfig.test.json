{
  // Type-checks the test suite and its helpers, which the build config
  // deliberately excludes. Vitest transpiles with esbuild and does not check
  // types, so without this a broken test helper would only surface at runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The build config roots at src/, but the vitest configs live beside
    // package.json. Nothing is emitted here, so widening the root is safe.
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  // `api/` is the Vercel entrypoint. The build config roots at src/ and
  // excludes it, so this is the only place it gets type-checked.
  "include": [
    "src/**/*.ts",
    "api/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
